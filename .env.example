# ── Telegram ────────────────────────────────────────────────────
# Оставьте пустым, если хотите открыть UI в браузере без бота.
# Для Telegram укажите токен от @BotFather.
BOT_TOKEN=

# Как бот получает обновления: polling (локально) или webhook (прод)
BOT_MODE=polling

# Локально — http://localhost:8000.
# Для Telegram Mini App нужен публичный HTTPS-адрес.
PUBLIC_URL=http://localhost:8000

# Для ссылок вида https://t.me/<bot>/<app>?startapp=event_...
# Заполняется только вместе с BOT_TOKEN.
BOT_USERNAME=
APP_SHORT_NAME=

# Секрет заголовка X-Telegram-Bot-Api-Secret-Token.
# Если пусто — вычисляется из BOT_TOKEN.
WEBHOOK_SECRET=

# ── Keycloak (OIDC) ─────────────────────────────────────────────
# Для входа в браузере без Telegram. Локально можно оставить false.
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SCOPES=openid profile email
# Обычно redirect_uri вычисляется как PUBLIC_URL + /api/v1/auth/keycloak/callback
# KEYCLOAK_REDIRECT_URI=
# Необязательные переопределения, если Keycloak отдаёт другие адреса:
# KEYCLOAK_AUTHORIZATION_ENDPOINT=
# KEYCLOAK_TOKEN_ENDPOINT=
# KEYCLOAK_JWKS_URI=

# ── Приложение ──────────────────────────────────────────────────
# Локальный вход без Telegram. Работает только при не-HTTPS PUBLIC_URL.
# В проде обязательно false.
DEV_BYPASS_AUTH=true

# Интервал проверки напоминаний, секунд
REMINDER_INTERVAL_SEC=60

# Максимальный размер обложки, МБ
MAX_COVER_MB=5

# ── База данных ─────────────────────────────────────────────────
# Используется локальным uvicorn и alembic.
# Порт 5433 выбран, чтобы не конфликтовать с уже установленным PostgreSQL.
DATABASE_URL=postgresql+asyncpg://calendar:calendar@localhost:5433/calendar

# Для docker compose:
POSTGRES_USER=calendar
POSTGRES_PASSWORD=calendar
POSTGRES_DB=calendar
# Порт PostgreSQL на хосте (внутри compose-сети всегда 5432)
POSTGRES_PORT=5433

# ── Docker ──────────────────────────────────────────────────────
APP_PORT=8000
BIND_ADDR=127.0.0.1
