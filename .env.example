# ── Токен бота от @BotFather (обязателен для работы в Telegram) ──
BOT_TOKEN=123456789:AAH...

# Секрет для подписи cookie-сессий и webhook. Любая случайная строка 32+ символов:
#   openssl rand -hex 32
SESSION_SECRET=

# Как бот получает обновления: webhook (прод) или polling (локально)
BOT_MODE=polling

# Публичный адрес приложения (для webhook и кнопки в чате)
PUBLIC_URL=http://localhost:3000

# Имена для ссылки на приложение (необязательно):
# https://t.me/<BOT_USERNAME>/<APP_SHORT_NAME>
BOT_USERNAME=
APP_SHORT_NAME=

# Вход в приложение без Telegram (только для localhost-разработки!)
DEV_BYPASS_AUTH=false
